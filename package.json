{
  "name": "codebusters",
  "private": true,
  "version": "1.0.0",
  "criticalVersion": 2,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generateProto.mjs && tsc -b && vite build",
    "build:functions": "node scripts/generateProto.mjs && npm --prefix functions run compile",
    "lint": "oxlint",
    "proto": "node scripts/generateProto.mjs",
    "preview": "vite preview",
    "setup:analytics": "node scripts/setupAnalyticsSink.mjs",
    "sync:users": "node scripts/syncUsersToBigQuery.mjs",
    "deploy:version": "node scripts/deployCriticalVersion.mjs",
    "deploy:rules": "node scripts/deployFirestoreRules.mjs",
    "prune:flags": "node scripts/pruneOrphanedQuoteFlags.mjs",
    "prune:drill-sessions": "node scripts/pruneDrillRecentSessions.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "firebase": "^13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uplot": "^1.6.31"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
